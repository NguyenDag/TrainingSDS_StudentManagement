@inject StudentService.StudentServiceClient StudentClient
@inject GrpcErrorHandler Errors
@inject IMessageService Messages
@inject ConfirmService Confirm

<Modal Title="@(_id is null ? UiText.AddStudent : UiText.EditStudent)"
       Visible="_visible"
       OnOk="@(() => _form?.Submit())"
       OnCancel="@(() => _visible = false)"
       ConfirmLoading="_saving"
       OkText="@UiText.Save"
       CancelText="@UiText.Cancel"
       DestroyOnClose>
    <Form @ref="_form" Model="_model" Layout="FormLayout.Vertical" OnFinish="SaveAsync" Validator="FormValidators.DataAnnotations">
        <FormItem Label="@UiText.StudentCode">
            <Input @bind-Value="context.Code" />
        </FormItem>
        <FormItem Label="@UiText.FullName">
            <Input @bind-Value="context.FullName" />
        </FormItem>
        <FormItem Label="@UiText.DateOfBirth">
            <DatePicker @bind-Value="context.DateOfBirth" Format="@UiText.DateFormat" Placeholder="@UiText.SelectDate" Style="width: 100%" />
        </FormItem>
        <FormItem Label="@UiText.Address">
            <Input @bind-Value="context.Address" />
        </FormItem>
        <FormItem Label="@UiText.Classroom">
            <ClassroomSelect @bind-Value="context.ClassroomId" Placeholder="@UiText.SelectClassroom" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private Form<StudentFormModel>? _form;
    private StudentFormModel _model = new();
    private int? _id;
    private int _version;
    private bool _visible;
    private bool _saving;

    public void ShowCreate(int? classroomId = null)
    {
        _id = null;
        _model = new StudentFormModel { ClassroomId = classroomId };
        _visible = true;
        StateHasChanged();
    }

    public void ShowEdit(Student student)
    {
        _id = student.Id;
        _version = student.Version;
        _model = new StudentFormModel();
        _model.Load(student);
        _visible = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var saved = await Errors.RunAsync(async () =>
        {
            if (_id is { } id)
                await StudentClient.UpdateStudentAsync(_model.ToUpdateRequest(id, _version));
            else
                await StudentClient.CreateStudentAsync(_model.ToCreateRequest());
        }, HandleErrorAsync);
        _saving = false;
        if (!saved) return;

        _visible = false;
        _ = Messages.SuccessAsync(UiText.Saved);
        await OnSaved.InvokeAsync();
    }

    private async Task<bool> HandleErrorAsync(ServerError error)
    {
        if (error.Status == Grpc.Core.StatusCode.Aborted && _id is { } id)
        {
            if (await Confirm.Show(UiText.StaleReloadQuestion, UiText.StaleTitle, ConfirmButtons.OKCancel) == ConfirmResult.OK)
                await Errors.RunAsync(async () =>
                {
                    var latest = await StudentClient.GetStudentAsync(new GetStudentRequest { Id = id });
                    _version = latest.Version;
                    _model.Load(latest);
                });
            return true;
        }
        return await GrpcErrorHandler.ShowOnForm(_form)(error);
    }
}
