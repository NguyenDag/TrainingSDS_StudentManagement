@inject ClassroomService.ClassroomServiceClient ClassroomClient
@inject GrpcErrorHandler Errors
@inject IMessageService Messages
@inject ConfirmService Confirm

<Modal Title="@(_id is null ? UiText.AddClassroom : UiText.EditClassroom)"
       Visible="_visible"
       OnOk="@(() => _form?.Submit())"
       OnCancel="@(() => _visible = false)"
       ConfirmLoading="_saving"
       OkText="@UiText.Save"
       CancelText="@UiText.Cancel"
       DestroyOnClose>
    <Form @ref="_form" Model="_model" Layout="FormLayout.Vertical" OnFinish="SaveAsync" Validator="FormValidators.DataAnnotations">
        <FormItem Label="@UiText.Code">
            <Input @bind-Value="context.Code" />
        </FormItem>
        <FormItem Label="@UiText.ClassroomName">
            <Input @bind-Value="context.Name" />
        </FormItem>
        <FormItem Label="@UiText.Subject">
            <Input @bind-Value="context.Subject" />
        </FormItem>
        <FormItem Label="@UiText.Teacher">
            <TeacherSelect @bind-Value="context.TeacherId" Placeholder="@UiText.SelectTeacher" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private Form<ClassroomFormModel>? _form;
    private ClassroomFormModel _model = new();
    private int? _id;
    private int _version;
    private bool _visible;
    private bool _saving;

    public void ShowCreate(int? teacherId = null)
    {
        _id = null;
        _model = new ClassroomFormModel { TeacherId = teacherId };
        _visible = true;
        StateHasChanged();
    }

    public void ShowEdit(Classroom classroom)
    {
        _id = classroom.Id;
        _version = classroom.Version;
        _model = new ClassroomFormModel();
        _model.Load(classroom);
        _visible = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var saved = await Errors.RunAsync(async () =>
        {
            if (_id is { } id)
                await ClassroomClient.UpdateClassroomAsync(_model.ToUpdateRequest(id, _version));
            else
                await ClassroomClient.CreateClassroomAsync(_model.ToCreateRequest());
        }, HandleErrorAsync);
        _saving = false;
        if (!saved) return;

        _visible = false;
        _ = Messages.SuccessAsync(UiText.Saved);
        await OnSaved.InvokeAsync();
    }

    private async Task<bool> HandleErrorAsync(ServerError error)
    {
        if (error.Status == Grpc.Core.StatusCode.Aborted && _id is { } id)
        {
            if (await Confirm.Show(UiText.StaleReloadQuestion, UiText.StaleTitle, ConfirmButtons.OKCancel) == ConfirmResult.OK)
                await Errors.RunAsync(async () =>
                {
                    var latest = await ClassroomClient.GetClassroomAsync(new GetClassroomRequest { Id = id });
                    _version = latest.Version;
                    _model.Load(latest);
                });
            return true;
        }
        return await GrpcErrorHandler.ShowOnForm(_form)(error);
    }
}
